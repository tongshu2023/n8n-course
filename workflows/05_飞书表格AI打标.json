            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI 逐行打标": {
      "main": [
        [
          {
            "node": "整理写回内容",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "整理写回内容": {
      "main": [
        [
          {
            "node": "写回飞书表",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DeepSeek 大模型": {
      "ai_languageModel": [
        [
          {
            "node": "AI 逐行打标",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
